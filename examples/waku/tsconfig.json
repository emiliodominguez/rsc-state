{
	"compilerOptions": {
		"strict": true,
		"target": "esnext",
		"noEmit": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"module": "esnext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"jsx": "react-jsx"
	},
	"include": ["src"]
}
