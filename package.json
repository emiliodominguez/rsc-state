{
	"name": "rsc-state",
	"version": "1.1.0",
	"description": "Type-safe state management for React Server Components, with derived state, hydration from storage adapters, middleware and transactional batches.",
	"type": "commonjs",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "NODE_ENV=production tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run && tsc -p tsconfig.test.json",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
		"prepare": "husky",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish",
		"commit": "commit"
	},
	"keywords": [
		"react",
		"server-components",
		"state-management",
		"nextjs",
		"rsc",
		"typescript",
		"react-server-components",
		"server-state"
	],
	"author": "Emilio Dominguez <emilioadominguezb@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/rsc-state.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/rsc-state/issues"
	},
	"homepage": "https://github.com/emiliodominguez/rsc-state#readme",
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/prompt-cli": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.4",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.10",
		"tsdown": "^0.23.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
